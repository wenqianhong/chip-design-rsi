+      const int degree = confidence == 3 && intern_->get_mshr_occupancy_ratio() < 0.5
+                             ? CONFIDENT_PREFETCH_DEGREE
+                             : PREFETCH_DEGREE;
+      active_lookahead = {champsim::address{cl_addr}, stride, degree};
+    }
   }
 
